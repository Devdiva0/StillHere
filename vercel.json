{
  "version": 2,
  "builds": [
    {
      "src": "Backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "Frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Backend/server.js"
    },
    {
      "src": "/room",
      "dest": "Frontend/room.html"
    },
    {
      "src": "/chat-room",
      "dest": "Frontend/chat-room.html"
    },
    {
      "src": "/tables",
      "dest": "Frontend/tables.html"
    },
    {
      "src": "/auth",
      "dest": "Frontend/auth.html"
    },
    {
      "src": "/(.*)",
      "dest": "Frontend/$1"
    }
  ]
}
